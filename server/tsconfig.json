{
  // 빌드 단계를 두지 않는다. Node 24는 실행할 때 타입만 벗겨내고 그대로 돌리므로
  // (type stripping) tsc는 "검사기"로만 쓰고 결과물은 내보내지 않는다(noEmit).
  // 그래서 dist/ 폴더도, tsx 같은 별도 런타임도 필요 없다.
  //
  // 대신 두 가지 제약이 따라온다. 아래 두 옵션이 그걸 컴파일러로 강제한다.
  // - allowImportingTsExtensions: Node는 "./db.js"를 db.ts로 바꿔 찾아주지 않는다.
  //   실제 파일 이름 그대로 "./db.ts"라고 써야 한다.
  // - erasableSyntaxOnly: enum·namespace처럼 지우기만 해서는 안 되는(런타임 코드를
  //   만들어내는) 문법을 금지한다. 이게 있어야 "타입만 벗기면 끝"이 성립한다.
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],

    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    // 타입 전용 import는 반드시 `import type`으로 쓰게 한다.
    // 안 그러면 타입만 있는 모듈을 런타임에 실제로 import하려다 죽는다.
    "verbatimModuleSyntax": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules"]
}
