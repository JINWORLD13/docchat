# Google AI Studio에서 무료 발급: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# 신규 발급 키는 gemini-2.5 계열을 못 쓴다. gemini-3.x flash 계열 사용.
GEMINI_CHAT_MODEL=gemini-3.6-flash

# 로컬 docker-compose 기준. Neon 등 클라우드 Postgres면 그 주소로 교체.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/docchat

PORT=4000

# 이 값보다 검색 유사도가 낮으면 답변을 거절한다 (query_logs 보면서 조정)
SIMILARITY_THRESHOLD=0.62

# --- 부하/장애 대응 설정 (자세한 설계는 RELIABILITY.md) ---

# 커넥션 풀 동시 연결 상한
# Bulkhead: 읽기=질문 검색 / 쓰기=업로드·로그 / 미디어=채팅 이미지 조회
# 미디어를 따로 두는 이유: 이미지 조회가 읽기 풀을 먹으면 질문 응답이 굶는다.
PG_READ_MAX=10
PG_WRITE_MAX=5
PG_MEDIA_MAX=4

# Rate Limiter (사용자별 Token Bucket): 버킷 용량 / 초당 충전 토큰
RL_CAPACITY=10
RL_REFILL=5

# 채팅 메시지 도배 제한. HTTP보다 좁은 이유는 한 명의 도배가
# 방 전체 사람들 화면을 덮기 때문.
# 키는 socket.id가 아니라 IP다 — socket.id는 재연결마다 새로 생겨서,
# 끊었다 붙는 것만으로 제한이 초기화된다(RELIABILITY.md 참고).
CHAT_RL_CAPACITY=5
CHAT_RL_REFILL=2

# 메시지가 아닌 소켓 이벤트(방 이동·입력중 표시) 제한.
# 메시지보다 싸지만 공짜는 아니다 — join 한 번은 방 목록을 접속자 전원에게
# 밀어내고, typing은 방 사람들에게 매번 뿌려진다.
CHAT_ACTION_CAPACITY=20
CHAT_ACTION_REFILL=10

# IP 하나가 열 수 있는 동시 소켓 수.
# 이게 없으면 연결을 여러 개 여는 것만으로 위 제한을 그 수만큼 곱할 수 있다.
CHAT_MAX_SOCKETS_PER_IP=10

# 방 무한 증식 방지. 방은 이름만 대면 생기므로(join = 생성) 상한이 필요하다.
# ROOM_TTL_MS: 사람이 다 나간 방을 재입장에 대비해 얼마나 붙잡아둘지.
MAX_ROOMS=500
ROOM_TTL_MS=1800000

# 채팅 이미지 업로드 제한. 한 건이 무거워서(최대 2MB가 DB로 들어감) 더 좁게.
IMG_RL_CAPACITY=5
IMG_RL_REFILL=0.5

# 채팅 이미지 보관 기간(ms). 기본 24시간.
# 속도 제한만으로는 총량이 안 잡힌다 — 느리게 꾸준히 올리면 영구히 쌓인다.
# 게다가 방 기록은 메모리에 있어 서버가 재시작하면 사라지는데, 이미지 행은
# 남아 아무도 참조하지 않는 바이트가 된다. 그래서 시간으로 자른다.
IMAGE_RETENTION_MS=86400000

# Admission Control: 동시 처리 상한 / 대기열 상한 (초과 시 429)
# MAX_QUEUE_WAIT_MS: 대기열에서 이만큼 기다려도 자리가 안 나면 포기하고 429
MAX_INFLIGHT=8
MAX_QUEUE=20
MAX_QUEUE_WAIT_MS=2000

# Circuit Breaker: 연속 실패 몇 번에 회로를 열까 / 얼마나(ms) 열어둘까
BREAKER_THRESHOLD=5
BREAKER_COOLDOWN_MS=10000

# 관리자(장애 주입) 엔드포인트 보호.
# 비워두면 localhost에서만 호출 가능 — 로컬 데모는 설정 없이 그대로 동작한다.
# 배포해서 원격에서 대시보드 데모를 돌리려면 값을 채우고, 프론트 빌드에도
# 같은 값을 VITE_ADMIN_TOKEN으로 넣는다.
# 주의: 프론트 빌드에 넣은 값은 번들에 평문으로 들어가 방문자 누구나 읽을 수
# 있다. 즉 그 배포는 장애 주입 데모를 공개하는 셈이다. 외부에 잠그려면
# 프론트에는 넣지 말고 서버에만 두고, 시연이 필요할 때 curl로 직접 호출한다.
ADMIN_TOKEN=

# req.ip를 무엇으로 정할지. rate limiter가 IP별로 버킷을 나누므로 이 값이
# 조작 가능하면 제한 전체가 무의미해진다.
# 기본 0 = 아무 프록시도 신뢰하지 않음 → req.ip는 실제 TCP 연결 주소라
# 클라이언트가 손댈 수 없다. 로드밸런서 뒤에 둘 때만 홉 수를 정확히 적는다.
# (실제보다 크게 적으면 그만큼 X-Forwarded-For를 신뢰하게 되어 제한이 뚫린다.)
TRUST_PROXY=0

# 브라우저에서 이 서버를 부를 수 있는 오리진 목록(쉼표 구분).
# 모두 허용(*)으로 두면 사용자가 방문한 아무 사이트나 이 서버에 요청을 보내고
# 응답까지 읽을 수 있다. admin이 "loopback이면 통과"인 로컬 데모에서 특히 위험하다.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- 테스트/측정용 ---
# LLM_PROVIDER=mock  → Gemini 대신 가짜 응답 (부하 테스트로 내 시스템만 측정)
# LLM_FAIL=1         → 생성을 일부러 실패시킴 (circuit breaker/degradation 재현)
